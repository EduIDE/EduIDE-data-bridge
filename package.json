{
    "name": "data-bridge",
    "displayName": "Data Bridge",
    "description": "Allows runtime configuration of cloud-based Theia IDEs",
    "version": "0.0.1",
    "publisher": "tum-aet",
    "repository": {
        "type": "git",
        "url": "https://github.com/EduIDE/EduIDE-data-bridge"
    },
    "engines": {
        "vscode": "^1.106.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "dataBridge.getEnv",
                "title": "Retrieve a list of environment variables"
            },
            {
                "command": "dataBridge.showLogs",
                "title": "Data Bridge: Show Logs"
            }
        ],
        "configuration": {
            "title": "Data Bridge",
            "properties": {
                "dataBridge.logLevel": {
                    "type": "string",
                    "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
                    "default": "DEBUG",
                    "description": "Controls the verbosity of logging in the Data Bridge output channel."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run build",
        "compile": "pnpm run ts:check && pnpm run lint && node esbuild.js",
        "watch:esbuild": "node esbuild.js --watch",
        "build": "pnpm run ts:check && pnpm run lint && node esbuild.js --production",
        "package": "vsce package --no-dependencies",
        "compile-tests": "tsc -p ./tsconfig.test.json",
        "watch-tests": "tsc -p ./tsconfig.test.json -w",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "ts:check": "tsc --noEmit",
        "ts:watch": "tsc --noEmit --watch --project tsconfig.json",
        "lint": "eslint src",
        "test": "vscode-test",
        "prettier:fix": "prettier --config .prettierrc --write  --list-different 'src/**/*.{ts,tsx}'"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.106.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.2.2",
        "esbuild": "^0.27.0",
        "eslint": "^9.39.1",
        "ovsx": "^0.10.4",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.18",
        "arktype": "^2.1.26",
        "hono": "^4.13.16"
    },
    "pnpm": {
        "overrides": {
            "@ark/util": "0.54.0",
            "@azure/msal-node>uuid": "^11.1.1",
            "@humanfs/node@<0.16.8": "^0.16.8",
            "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
            "ajv@>=6 <6.14.0": "^6.15.0",
            "ajv@>=8 <8.18.0": "^8.20.0",
            "brace-expansion@<1.1.21": "^1.1.21",
            "brace-expansion@>=2 <2.1.7": "^2.1.7",
            "fast-uri@<3.1.9": "^3.1.9",
            "flatted@<3.4.2": "^3.4.4",
            "follow-redirects@<1.16.0": "^1.16.2",
            "form-data@>=4 <4.0.6": "^4.0.6",
            "glob@>=10 <10.5.0": "^10.5.0",
            "glob@>=11 <11.1.0": "^11.1.0",
            "js-yaml@>=3 <3.15.2": "^3.15.2",
            "js-yaml@>=4 <4.3.2": "^4.3.2",
            "jws@<3.2.3": "^3.2.3",
            "linkify-it@<5.0.2": "^5.0.2",
            "lodash@<4.18.0": "^4.18.1",
            "markdown-it@>=14 <14.3.3": "^14.3.3",
            "minimatch@>=3 <3.1.4": "^3.1.5",
            "minimatch@>=9 <9.0.7": "^9.0.9",
            "minimatch@>=10 <10.2.3": "^11.0.0",
            "mocha>serialize-javascript": "^7.1.4",
            "picomatch@<2.3.2": "^2.3.2",
            "qs@<6.16.1": "^6.17.1",
            "tmp@<0.2.6": "^0.2.7",
            "underscore@<1.13.8": "^1.13.8",
            "undici@>=7 <7.30.1": "^7.30.2"
        }
    }
}
